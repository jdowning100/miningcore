# Quai Payout Service Environment Variables
# Copy this file to .env and set your private keys

# Private key for SHA mining wallet (hex format, with or without 0x prefix)
POOL_PRIVATE_KEY_SHA=0xYOUR_SHA_PRIVATE_KEY_HERE

# Private key for Scrypt mining wallet (hex format, with or without 0x prefix)
# Leave empty or omit if not running scrypt
POOL_PRIVATE_KEY_SCRYPT=
